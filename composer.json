{
    "name": "slimad/indexnow-laravel",
    "description": "Laravel integration for IndexNow: service provider, configuration, cache/database backed queues, queued job, Artisan commands, scheduler binding and an Eloquent trait for submitting URL changes to Bing, Yandex, Seznam, Naver and Yep.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "indexnow",
        "seo",
        "bing",
        "yandex",
        "seznam",
        "naver",
        "yep",
        "search-engine",
        "indexing"
    ],
    "authors": [
        {
            "name": "Maciej Kosiedowski",
            "homepage": "https://github.com/maciej-kosiedowski",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/maciej-kosiedowski/IndexNow-for-Laravel",
    "support": {
        "issues": "https://github.com/maciej-kosiedowski/IndexNow-for-Laravel/issues",
        "source": "https://github.com/maciej-kosiedowski/IndexNow-for-Laravel",
        "security": "https://github.com/maciej-kosiedowski/IndexNow-for-Laravel/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "slimad/indexnow": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.29 || ^0.35",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SlimAD\\IndexNow\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlimAD\\IndexNow\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "aliases": {
                "IndexNow": "SlimAD\\IndexNow\\Laravel\\Facades\\IndexNow"
            },
            "providers": [
                "SlimAD\\IndexNow\\Laravel\\IndexNowServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "ci": [
            "@cs",
            "@phpstan",
            "@test",
            "@infection"
        ],
        "cs": "pint --test",
        "cs:fix": "pint",
        "infection": "infection --threads=max",
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=build/coverage"
    },
    "scripts-descriptions": {
        "ci": "Runs the full local quality gate: coding standards, static analysis, tests and mutation testing.",
        "cs": "Checks the coding standards without modifying files.",
        "cs:fix": "Fixes coding standard violations in place.",
        "infection": "Runs mutation testing and enforces the configured minimum mutation score.",
        "phpstan": "Runs Larastan static analysis.",
        "test": "Runs the PHPUnit test suite against Testbench.",
        "test:coverage": "Runs the test suite and generates a coverage report."
    }
}

{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection.log",
        "html": "build/infection.html",
        "summary": "build/infection-summary.log"
    },
    "mutators": {
        "@default": true,
        // Str::squish() declares no parameter type, so it coerces scalars on its
        // own and dropping the (string) cast in front of it changes nothing a
        // test can observe. The cast still earns its place: it is what keeps a
        // null config value away from preg_replace(), which deprecates null
        // subjects on PHP 8 and rejects them on PHP 9.
        "CastString": {
            "ignoreSourceCodeByRegex": [
                ".*Str::squish\\(\\(string\\).*"
            ]
        }
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    "testFramework": "phpunit"
}
